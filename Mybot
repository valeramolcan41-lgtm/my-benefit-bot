async def deals(callback: types.CallbackQuery):
    text = "🔥 <b>Выгодные акции сегодня</b>\n\n"
    text += "• СберМаркет: -500₽ на первый заказ\n"
    text += "• Яндекс Еда: -40% на 3 заказа\n"
    text += "• Аскона: -30% на матрасы\n\n"
