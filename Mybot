import asyncio
import logging
import sqlite3
import os
from datetime import datetime
from aiogram import Bot, Dispatcher, types, F
from aiogram.types import LabeledPrice, PreCheckoutQuery
from aiogram.filters import Command
from aiogram.utils.keyboard import InlineKeyboardBuilder

TOKEN = os.getenv("BOT_TOKEN")
ADMIN_ID = int(os.getenv("ADMIN_ID", "0"))

bot = Bot(token=TOKEN)
dp = Dispatcher()

conn = sqlite3.connect("users.db")
cur = conn.cursor()
cur.execute("""CREATE TABLE IF NOT EXISTS users (
    id INTEGER PRIMARY KEY,
    username TEXT,
    joined TEXT,
    paid INTEGER DEFAULT 0,
    refs INTEGER DEFAULT 0
)""")
conn.commit()

def add_user(uid, username):
    cur.execute("INSERT OR IGNORE INTO users (id, username, joined) VALUES (?, ?, datetime('now'))", (uid, username))
    conn.commit()

def is_paid(uid):
    cur.execute("SELECT paid FROM users WHERE id=?", (uid,))
    r = cur.fetchone()
    return r and r[0] == 1

def set_paid(uid):
    cur.execute("UPDATE users SET paid=1 WHERE id=?", (uid,))
    conn.commit()

def add_ref(uid):
    cur.execute("UPDATE users SET refs = refs + 1 WHERE id=?", (uid,))
    conn.commit()

def get_stats():
    cur.execute("SELECT COUNT(*) FROM users")
    total = cur.fetchone()[0]
    cur.execute("SELECT COUNT(*) FROM users WHERE paid=1")
    paid = cur.fetchone()[0]
    return total, paid

def main_menu(uid):
    paid = is_paid(uid)
    text = "🤑 <b>Ежедневная выгода</b>\n\n"
    text += "✅ Премиум активен" if paid else "🔓 Бесплатный доступ"
    kb = InlineKeyboardBuilder()
    kb.button(text="🎁 Промокоды дня", callback_data="promo")
    kb.button(text="💡 Лайфхак дня", callback_data="lifehack")
    kb.button(text="🔥 Выгодные акции", callback_data="deals")
    if not paid:
        kb.button(text="💎 Премиум — 50 Stars", callback_data="buy")
    kb.button(text="👥 Пригласить друга", callback_data="ref")
    kb.adjust(2)
    return text, kb.as_markup()

@dp.message(Command("start"))
async def start(message: types.Message):
    add_user(message.from_user.id, message.from_user.username or "")
    args = message.text.split()
    if len(args) > 1 and args[1].startswith("ref"):
        try:
            inviter = int(args[1].replace("ref", ""))
            if inviter != message.from_user.id:
                add_ref(inviter)
        except ValueError:
            pass
    text, kb = main_menu(message.from_user.id)
    await message.answer(text, reply_markup=kb, parse_mode="HTML")

@dp.callback_query(F.data == "promo")
async def promo(callback: types.CallbackQuery):
    today = datetime.now().strftime("%d.%m.%Y")
    text = f"🎁 <b>Промокоды на {today}</b>\n\n"
    text += "1. <b>OZON10</b> — скидка 10% на первый заказ\n"
    text += "2. <b>WB15</b> — скидка 15% на всё\n"
    text += "3. <b>YANDEX300</b> — 300₽ на такси\n\n"
    text += "💎 <i>Премиум-промокоды (до 50%) — в разделе Премиум</i>"
    kb = InlineKeyboardBuilder()
    kb.button(text="🛒 Открыть Ozon", url="https://ozon.ru")
    kb.button(text="🛍 Открыть WB", url="https://wildberries.ru")
    kb.button(text="⬅️ Назад", callback_data="back")
    kb.adjust(2)
    await callback.message.edit_text(text, reply_markup=kb.as_markup(), parse_mode="HTML")
    await callback.answer()

