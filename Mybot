@dp.callback_query(F.data == "buy")
async def buy(callback: types.CallbackQuery):
    await bot.send_invoice(
        chat_id=callback.from_user.id,
        title="Премиум доступ",
        description="Промокоды до 50%, закрытые акции, ранний доступ",
        payload="premium_access",
        provider_token="",
        currency="XTR",
        prices=[LabeledPrice(label="Премиум", amount=50)]
    )
    await callback.answer()

@dp.pre_checkout_query()
async def pre_checkout(query: PreCheckoutQuery):
    await bot.answer_pre_checkout_query(query.id, ok=True)

@dp.message(F.successful_payment)
async def payment(message: types.Message):
    set_paid(message.from_user.id)
    await message.answer("✅ Премиум активирован! Теперь тебе доступны промокоды до 50% и закрытые акции.")
    if ADMIN_ID:
        await bot.send_message(ADMIN_ID, f"💰 Новая оплата: {message.from_user.id}")

@dp.callback_query(F.data == "ref")
async def ref(callback: types.CallbackQuery):
    me = await bot.get_me()
    link = f"https://t.me/{me.username}?start=ref{callback.from_user.id}"
    text = f"👥 <b>Реферальная программа</b>\n\n"
    text += f"Твоя ссылка:\n<code>{link}</code>\n\n"
    text += "За каждого друга — бонусы и бесплатные премиум-дни."
    kb = InlineKeyboardBuilder()
    kb.button(text="⬅️ Назад", callback_data="back")
    await callback.message.edit_text(text, reply_markup=kb.as_markup(), parse_mode="HTML")
    await callback.answer()

@dp.callback_query(F.data == "back")
async def back(callback: types.CallbackQuery):
    text, kb = main_menu(callback.from_user.id)
    await callback.message.edit_text(text, reply_markup=kb, parse_mode="HTML")
    await callback.answer()

@dp.message(Command("stats"))
async def stats(message: types.Message):
    if message.from_user.id != ADMIN_ID:
        return
    total, paid = get_stats()
    await message.answer(f"👥 Всего: {total}\n💰 Премиум: {paid}\n💵 Доход: {paid * 50} Stars")

async def main():
    logging.basicConfig(level=logging.INFO)
    await dp.start_polling(bot)

if __name__ == "__main__":
    asyncio.run(main())
